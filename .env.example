# Optional: point the app at a different Supabase project (defaults are in app.config.js).
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
#
# The Anthropic API key is NOT used by the app. It is a secret on the Supabase
# `tutor` edge function (Edge Functions -> Secrets -> ANTHROPIC_API_KEY).

# RevenueCat public SDK keys (Project settings -> API keys). Purchases stay hidden until set.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
