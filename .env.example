# For local development with `expo start` — copy to .env and fill in:
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For EAS builds, set the key as an EAS secret (recommended — never stored in git):
#   eas secret:create --scope project --name ANTHROPIC_API_KEY --value sk-ant-...
#
# Or add it directly to eas.json under each build profile's "env" section
# (only do this for non-production builds; avoid committing real keys):
#   "env": { "ANTHROPIC_API_KEY": "sk-ant-..." }
